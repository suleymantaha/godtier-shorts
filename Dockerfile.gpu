FROM python:3.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    APP_ENV=production \
    WORKER_MODE=gpu \
    REQUIRE_CUDA_FOR_APP=1 \
    REQUIRE_NVENC_FOR_APP=1 \
    GODTIER_WORKSPACE=/scratch/workspace \
    GPU_SCRATCH_ROOT=/scratch/jobs \
    GODTIER_MODELS_DIR=/models \
    HF_HOME=/models/huggingface \
    YOLO_CONFIG_DIR=/models/ultralytics \
    YOLO_MODEL_PATH=/models/yolo11s.pt

WORKDIR /app

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ffmpeg \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system godtier \
    && useradd --system --gid godtier --home-dir /app godtier

COPY requirements.txt requirements.lock ./
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements.lock \
    && python -m pip install -r requirements.txt

RUN python -c "import ctranslate2, torch, ultralytics" \
    && ffmpeg -hide_banner -encoders 2>/dev/null | grep -q h264_nvenc

COPY backend ./backend
COPY docker/gpu-entrypoint.sh ./docker/gpu-entrypoint.sh

RUN mkdir -p /models /scratch/jobs /scratch/workspace \
    && chmod 0755 /app/docker/gpu-entrypoint.sh \
    && chown -R godtier:godtier /app /models /scratch

USER godtier

VOLUME ["/models", "/scratch"]

ENTRYPOINT ["/app/docker/gpu-entrypoint.sh"]
